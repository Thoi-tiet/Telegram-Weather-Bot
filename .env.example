# Telegram Bot API Token (get from @BotFather on Telegram)
TELEGRAM_API=your_telegram_bot_token_here

# OpenWeatherMap API Key (get from https://openweathermap.org/api)
OWM_API_KEY=your_openweathermap_api_key_here

# Timeout for API requests (optional, defaults to 10000ms)
TIMEOUT_MS=10000

# Port for keepalive server (defaults to 5000)
PORT=5000